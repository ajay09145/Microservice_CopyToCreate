@using Mango.Web.Models
@model CouponDto;

<form method="post">
    <br/>
    <div class="container border p-3">
        <h1 class="text-white text-center">Create Coupon</h1>
        <hr />
        <div class="row">
            <div class="row">
                <div class="col-2">
                    <label class="form-label pt-2" style="font-size:20px">Coupon Code</label>
                </div>
                <div class="col-10 pb-3">
                    <input type="text" class="form-control" asp-for="CouponCode" placeholder="Enter Coupon Code"/>
                    <span asp-validation-for="CouponCode" class="text-danger"></span>
                </div>
                <div class="col-2">
                    <label class="form-label pt-2" style="font-size:20px">Discount Amount</label>
                </div>
                <div class="col-10 pb-3">
                    <input type="text" class="form-control" asp-for="DicountAmount" placeholder="Enter Discount Amount" />
                    <span asp-validation-for="DicountAmount" class="text-danger"></span>
                </div>
                <div class="col-2">
                    <label class="form-label pt-2" style="font-size:20px">Minimum Amount</label>
                </div>
                <div class="col-10 pb-3">
                    <input type="text" class="form-control" asp-for="MinAount" placeholder="Enter Minimum Amount" />
                    <span asp-validation-for="MinAount" class="text-danger"></span>
                </div>
              @*   <div class="col-2">
                    <label class="form-label pt-2" style="font-size:20px">Last Update</label>
                </div>
                <div class="col-10 pb-3">
                    <input type="date" class="form-control" asp-for="LastUpdated" placeholder="Enter Coupon Code" />
                    <span asp-validation-for="LastUpdated" class="text-danger"></span>
                </div> *@
                <div class="col-5 offset-2">
                    <a asp-action="CouponIndex" class="btn btn-primary form-control">Back To List</a>
                </div>
                <div class="col-5 ">
                    @* <input asp-action="CouponCreate" type="submit" class="btn btn-success form-control" value="Create"> *@
                    <button type="submit" asp-action="CouponCreate" class="btn btn-success form-control">Create</button>
                </div>
            </div>
        </div>
    </div>
</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}





