@using Mango.Web.Models
@model CouponDto

<form method="post">
    <br />
    <div class="container border p-3">
        <h1 class="text-white text-center">Delete Coupon</h1>
        <hr />
        <div class="row">
            <div class="col-2">
                <label class="form-label pt-2" style="font-size:20px">Coupon Code</label>
            </div>
            <div class="col-10 pb-3">
                <p class="form-control">@Model?.CouponCode</p>
            </div>

            <div class="col-2">
                <label class="form-label pt-2" style="font-size:20px">Discount Amount</label>
            </div>
            <div class="col-10 pb-3">
                <p class="form-control">@Model?.DicountAmount</p>
            </div>

            <div class="col-2">
                <label class="form-label pt-2" style="font-size:20px">Minimum Amount</label>
            </div>
            <div class="col-10 pb-3">
                <p class="form-control">@Model?.MinAount</p>
            </div>

            <input type="hidden" asp-for="CouponId" />

            <div class="col-5 offset-2">
                <a asp-action="CouponIndex" class="btn btn-primary form-control">Back To List</a>
            </div>
            <div class="col-5 ">
                <button type="submit" class="btn btn-danger form-control">Delete</button>
            </div>
        </div>
    </div>
</form>
