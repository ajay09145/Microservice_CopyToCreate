@model RegistrationRequestDto

<form method="post" enctype="multipart/form-data">
    <div class="container border p-4">
        <div class="row" text-center">
            <h1>Registration</h1>
        </div>
        <div class="row">
            <div class="col-12 col-md-6 offset-md-3 pb-2">
                <input asp-for="Email" class="form-control" placeholder="Email...." />
                <span class="text-danger" asp-validation-for="Email"></span>
            </div>
            <div class="col-12 col-md-6 offset-md-3 pb-2">
                <input asp-for="Name" class="form-control" placeholder="Name...." />
                <span class="text-danger" asp-validation-for="Name"></span>
            </div>
            <div class="col-12 col-md-6 offset-md-3 pb-2">
                <input asp-for="PhoneNumber" class="form-control" placeholder="PhoneNumber...." />
                <span class="text-danger" asp-validation-for="PhoneNumber"></span>
            </div>
            <div class="col-12 col-md-6 offset-md-3 pb-2">
                <input asp-for="Password" class="form-control" placeholder="Password...." />
                <span class="text-danger" asp-validation-for="Password"></span>
            </div>
            <div class="col-12 col-md-6 offset-md-3 pb-2">
                <select asp-for="Role" class="form-select" asp-items="@ViewBag.RoleList"> 
                    <option>--Select Role--</option>
                </select>
                <span class="text-danger" asp-validation-for="Password"></span>
            </div>
            <div class="col-12 col-md-6 offset-md-3 pb-2">
                <button type="submit" class="form-control btn btn-success" value="Submit">Register</button>
            </div>
        </div>
    </div>
</form>