@using Mango.Web.Models
@model ProductDto;

<form method="post">
    <br />
    <div class="container border p-3">
        <h1 class="text-white text-center">Product Create</h1>
        <hr />
        <div class="row">
            <div class="row">
                <div class="col-2">
                    <label class="form-label pt-2" style="font-size:20px">Product Name</label>
                </div>
                <div class="col-10 pb-3">
                    <input type="text" class="form-control" asp-for="Name" placeholder="Enter Coupon Code" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-2">
                    <label class="form-label pt-2" style="font-size:20px">Category Name</label>
                </div>
                <div class="col-10 pb-3">
                    <input type="text" class="form-control" asp-for="CategoryName" placeholder="Enter Discount Amount" />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                </div>
                <div class="col-2">
                    <label class="form-label pt-2" style="font-size:20px">Price</label>
                </div>
                <div class="col-10 pb-3">
                    <input type="text" class="form-control" asp-for="Price" placeholder="Enter Minimum Amount" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-2">
                    <label class="form-label pt-2" style="font-size:20px">Description</label>
                </div>
                <div class="col-10 pb-3">
                    <textarea rows="5" class="form-control" asp-for="Description" placeholder="Enter Coupon Code" ></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-2">
                    <label class="form-label pt-2" style="font-size:20px">Image Url</label>
                </div>
                <div class="col-10 pb-3">
                    <input type="text" class="form-control" asp-for="ImageUrl" placeholder="Enter Coupon Code" />
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                </div>
                <div class="col-5 offset-2">
                    <a asp-action="ProductIndex" class="btn btn-primary form-control">Back To List</a>
                </div>
                <div class="col-5 ">
                    @* <input asp-action="CouponCreate" type="submit" class="btn btn-success form-control" value="Create"> *@
                    <button type="submit" asp-action="ProductCreate" class="btn btn-success form-control">Create</button>
                </div>
            </div>
        </div>
    </div>
</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}





