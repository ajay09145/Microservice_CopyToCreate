@using Mango.Web.Models
@model ProductDto

<form method="post">
    <br />
    <div class="container border p-3">
        <h1 class="text-white text-center">Delete Product</h1>
        <hr />
        <div class="row">
            <div class="col-2">
                <label class="form-label pt-2" style="font-size:20px">Product Name</label>
            </div>
            <div class="col-10 pb-3">
                <p class="form-control">@Model?.Name</p>
            </div>

            <div class="col-2">
                <label class="form-label pt-2" style="font-size:20px">Category Name</label>
            </div>
            <div class="col-10 pb-3">
                <p class="form-control">@Model?.CategoryName</p>
            </div>

            <div class="col-2">
                <label class="form-label pt-2" style="font-size:20px">Price</label>
            </div>
            <div class="col-10 pb-3">
                <p class="form-control">@Model?.Price</p>
            </div>

            <div class="col-2">
                <label class="form-label pt-2" style="font-size:20px">Description</label>
            </div>
            <div class="col-10 pb-3">
                <p class="form-control">@Model?.Description</p>
            </div>

            <div class="col-2">
                <label class="form-label pt-2" style="font-size:20px">Image Url</label>
            </div>
            <div class="col-10 pb-3">
                <p class="form-control">@Model?.ImageUrl</p>
            </div>

            <input type="hidden" asp-for="ProductId" />

            <div class="col-5 offset-2">
                <a asp-action="ProductIndex" class="btn btn-primary form-control">Back To List</a>
            </div>
            <div class="col-5 ">
                <button type="submit" class="btn btn-danger form-control">Delete</button>
            </div>
        </div>
    </div>
</form>
